# ─────────────────────────────────────────────────────────────
#  Золотая рыбка — пример переменных окружения
#  Скопируй в .env и заполни. Файл .env НИКОГДА не коммитится.
# ─────────────────────────────────────────────────────────────

# ── Фронтенд ─────────────────────────────────────────────────
# База API. По умолчанию относительный /api: в dev его проксирует Vite,
# в проде — reverse proxy или отдельный домен бэкенда.
VITE_API_BASE_URL=/api

# Только для vite.config.ts: куда проксировать /api в dev.
VITE_PROXY_TARGET=http://127.0.0.1:8000

# ── LLM (любой OpenAI-совместимый API) ───────────────────────
# Ключи читает ТОЛЬКО бэкенд. Никогда не давай им префикс VITE_:
# всё с VITE_ попадает в клиентский бандл.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Резервный бесплатный провайдер (OpenRouter free / Gemini).
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# Локальный Ollama — предпоследний рубеж перед офлайн-ответами.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:7b-instruct

# ── Данные ───────────────────────────────────────────────────
# PostgreSQL (Neon/Supabase). Если пусто — локальный JSON в DATA_DIR.
DATABASE_URL=
DATA_DIR=backend/data

# ── Безопасность ─────────────────────────────────────────────
# Источники, которым разрешён CORS (через запятую).
CORS_ORIGINS=http://localhost:5173

# Мягкий лимит запросов на пользователя/IP в минуту.
RATE_LIMIT_PER_MINUTE=30

# Секрет для подписи magic-link токенов: openssl rand -hex 32
MAGIC_LINK_SECRET=

# Публичный адрес приложения — нужен для ссылок в письмах.
PUBLIC_BASE_URL=http://localhost:5173
